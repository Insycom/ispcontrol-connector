NODE_ENV=development
DATABASE_URL=postgresql://ispcontrol:ispcontrol@localhost:5432/ispcontrol
AUTH_SECRET=change-me-with-at-least-32-random-characters
# Generar con: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=change-me-with-a-32-byte-base64-key
API_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
WEB_URL=http://ispcontrol.local
# Lista separada por comas. Agrega aquí los orígenes permitidos.
WEB_URLS=http://ispcontrol.local,http://global.conector.ispcontrol.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=IspControl <no-reply@ispcontrol.local>
